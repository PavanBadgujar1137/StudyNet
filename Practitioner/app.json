{
  "expo": {
    "name": "OpenHand Practitioner",
    "slug": "openhand-practitioner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1235"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "live.openhand.practitioner"
    },
    "android": {
      "package": "live.openhand.practitioner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E1235",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://api.openhand.live/api/v1",
      "platformDomain": "openhand.live",
      "cloudfrontDomain": "d2ruooz1ktuxdd.cloudfront.net",
      "eas": {
        "projectId": "b08728dd-674d-456c-80f3-f799f7b4aaaa"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b08728dd-674d-456c-80f3-f799f7b4aaaa"
    },
    "plugins": [
      "expo-font",
      "expo-updates"
    ],
    "owner": "rashid_khopatkar"
  }
}
