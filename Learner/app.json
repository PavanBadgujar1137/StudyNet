{
  "expo": {
    "name": "OpenHand Learner",
    "slug": "openhand-learner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F8FD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "live.openhand.learner"
    },
    "android": {
      "package": "live.openhand.learner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F8FD",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://api.openhand.live/api/v1",
      "platformDomain": "openhand.live",
      "cloudfrontDomain": "d2ruooz1ktuxdd.cloudfront.net",
      "eas": {
        "projectId": "ccd2d7b9-31a9-42be-83c1-76d334632421"
      }
    },
    "owner": "aryan3025",
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ccd2d7b9-31a9-42be-83c1-76d334632421"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Feather.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf"
          ]
        }
      ],
      "expo-updates"
    ]
  }
}