# ==============================================================================
# Frontend Environment Configuration - StudyNet / OpenHand
# ==============================================================================

# Backend API Base URL (used by Axios services and Socket.io)
REACT_APP_BASE_URL=http://localhost:4000/api/v1

# Social Auth Client IDs (Google & LinkedIn Sign-In)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
REACT_APP_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here

# Social Media Studio Configuration
REACT_APP_PLATFORM_DOMAIN=openhand.live
REACT_APP_ENABLE_SOCIAL_DISPATCH=true
